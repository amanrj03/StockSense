// Lemon — Inventory Management System
// Prisma 7 schema for PostgreSQL (Neon)
// FDS v1.1  |  Schema revision 3.1 — hardened
//
// Key design decisions:
//
// 1. WAREHOUSE DERIVATION
//    warehouseId is NOT stored on Stock or operation records.
//    It is always derived from location.warehouseId.
//    This eliminates the warehouse/location inconsistency entirely.
//
// 2. STOCK MOVEMENT INTEGRITY
//    StockMovement carries a sourceType enum (discriminator) + four nullable
//    FK columns. The service layer enforces exactly one FK is set, matching
//    sourceType. The discriminator makes this easy to validate and query.
//
// 3. TRANSFER MOVEMENTS
//    Each InternalTransferLine produces exactly two StockMovement rows:
//      - TRANSFER_OUT  (fromLocation = source,  toLocation = null)
//      - TRANSFER_IN   (fromLocation = null,     toLocation = destination)
//    Total stock is unchanged; only location changes.
//
// 4. STOCK RESERVATION LIFECYCLE
//    Stock.reserved tracks quantity reserved against open Delivery Orders.
//    Service layer rules:
//      DeliveryOrder → WAITING/READY  : reserved += qty  (if stock available)
//      DeliveryOrder → DONE           : reserved -= qty, onHand -= qty
//      DeliveryOrder → CANCELED       : reserved -= qty
//
// 5. STOCK SCREEN IS READ-ONLY
//    Direct onHand edits are NOT permitted from the Stock screen.
//    All stock corrections must go through StockAdjustment → StockMovement.
//
// 6. REFERENCE NUMBER GENERATION
//    OperationCounter provides atomic per-warehouse per-type auto-increment.
//    Format: <warehouse.shortCode>/<opCode>/<sequence padded to 4 digits>
//    e.g. WH/IN/0001, WH/OUT/0002, WH/INT/0001, WH/ADJ/0001
//
// 7. HISTORICAL RECORDS
//    StockMovement rows are insert-only. No updates or deletes allowed
//    (enforced at the service layer; no cascade deletes from movements).
//    Operation records (Receipt, DeliveryOrder, etc.) use onDelete: Restrict
//    on their StockMovement relations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// datasource url is managed via prisma7.config.ts / DATABASE_URL env var
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ReceiptStatus {
  DRAFT
  READY
  DONE
  CANCELED
}

enum DeliveryOrderStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum TransferStatus {
  DRAFT
  READY
  DONE
  CANCELED
}

enum AdjustmentStatus {
  DRAFT
  DONE
}

enum AdjustmentReason {
  DAMAGED
  LOST
  MISCOUNT
  OTHER
}

// Discriminator for StockMovement.sourceType — enforces exactly-one-source rule
enum MovementSource {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

// Direction of a StockMovement row
enum MovementType {
  RECEIPT       // stock in  (Receipt validated)
  DELIVERY      // stock out (DeliveryOrder validated)
  TRANSFER_OUT  // stock leaves source location
  TRANSFER_IN   // stock arrives at destination location
  ADJUSTMENT    // stock corrected (positive or negative difference)
}

// ─── Auth.js v5 required models ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  loginId       String    @unique // 6–12 chars
  email         String    @unique
  emailVerified DateTime? // required by Auth.js
  passwordHash  String?   // nullable: social login users may not have a password
  image         String?   // Auth.js profile image
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  internalTransfers InternalTransfer[]
  adjustments       StockAdjustment[]

  @@index([loginId])
  @@index([email])
}

// Auth.js OAuth account link
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js database session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// Auth.js email verification token (OTP / magic link)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// ─── Warehouse & Location ─────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique // e.g. "WH", "WH2" — used in reference numbers
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations        Location[]
  operationCounters OperationCounter[]

  @@index([shortCode])
}

// Location belongs to exactly one Warehouse.
// All operations reference a Location; warehouse is derived from it.
model Location {
  id          String    @id @default(cuid())
  name        String
  shortCode   String    // e.g. "STOCK1", "RACK-A"
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stockEntries             Stock[]
  receiptsTo               Receipt[]          @relation("ReceiptToLocation")
  deliveryOrdersFrom       DeliveryOrder[]    @relation("DeliveryFromLocation")
  transfersSource          InternalTransfer[] @relation("TransferSourceLocation")
  transfersDestination     InternalTransfer[] @relation("TransferDestinationLocation")
  adjustments              StockAdjustment[]
  movementsFrom            StockMovement[]    @relation("MovementFromLocation")
  movementsTo              StockMovement[]    @relation("MovementToLocation")

  @@unique([shortCode, warehouseId])
  @@index([warehouseId])
}

// ─── Reference Number Counter ─────────────────────────────────────────────────
// Provides atomic per-warehouse per-opCode sequence numbers.
// opCode: IN | OUT | INT | ADJ
// Service layer uses: SELECT ... FOR UPDATE to increment atomically.

model OperationCounter {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  opCode      String    // "IN" | "OUT" | "INT" | "ADJ"
  lastSeq     Int       @default(0)

  @@unique([warehouseId, opCode])
  @@index([warehouseId])
}

// ─── Product & Category ───────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  sku           String    @unique
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  unitOfMeasure String    @default("pcs") // e.g. pcs, kg, ltr
  perUnitCost   Decimal   @default(0) @db.Decimal(12, 2)
  reorderLevel  Int?      // low-stock alert threshold
  reorderQty    Int?      // suggested reorder quantity
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockEntries  Stock[]
  receiptLines  ReceiptLine[]
  deliveryLines DeliveryOrderLine[]
  transferLines InternalTransferLine[]
  adjustments   StockAdjustment[]
  movements     StockMovement[]

  @@index([sku])
  @@index([categoryId])
}

// ─── Stock ────────────────────────────────────────────────────────────────────
// One row per (product, location).
// Warehouse is derived via location.warehouseId — not stored here.
//
// freeToUse = onHand - reserved  (computed in application layer, never stored)
// onHand and reserved are updated atomically inside DB transactions.

model Stock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  onHand     Decimal  @default(0) @db.Decimal(12, 3)
  reserved   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

// ─── Receipt (WH/IN/xxxx) ─────────────────────────────────────────────────────
// toLocationId determines the warehouse (location.warehouseId).

model Receipt {
  id            String        @id @default(cuid())
  reference     String        @unique // e.g. WH/IN/0001
  toLocationId  String
  toLocation    Location      @relation("ReceiptToLocation", fields: [toLocationId], references: [id])
  contact       String        // vendor / supplier name
  scheduleDate  DateTime
  responsibleId String
  responsible   User          @relation(fields: [responsibleId], references: [id])
  status        ReceiptStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines     ReceiptLine[]
  // Restrict prevents deleting a Receipt that has logged movements (audit trail)
  movements StockMovement[] @relation("MovementReceipt")

  @@index([toLocationId])
  @@index([status])
  @@index([scheduleDate])
  @@index([reference])
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)

  @@index([receiptId])
  @@index([productId])
}

// ─── Delivery Order (WH/OUT/xxxx) ────────────────────────────────────────────
// fromLocationId determines the warehouse.

model DeliveryOrder {
  id              String              @id @default(cuid())
  reference       String              @unique // e.g. WH/OUT/0001
  fromLocationId  String
  fromLocation    Location            @relation("DeliveryFromLocation", fields: [fromLocationId], references: [id])
  contact         String              // customer name
  deliveryAddress String?
  operationType   String?             // delivery sub-type dropdown
  scheduleDate    DateTime
  responsibleId   String
  responsible     User                @relation(fields: [responsibleId], references: [id])
  status          DeliveryOrderStatus @default(DRAFT)
  pickedAt        DateTime?
  packedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lines     DeliveryOrderLine[]
  movements StockMovement[]     @relation("MovementDelivery")

  @@index([fromLocationId])
  @@index([status])
  @@index([scheduleDate])
  @@index([reference])
}

model DeliveryOrderLine {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)

  @@index([deliveryOrderId])
  @@index([productId])
}

// ─── Internal Transfer (WH/INT/xxxx) ─────────────────────────────────────────
// sourceLocationId determines the warehouse.
// Service layer validates: sourceLocation.warehouseId may differ from
// destinationLocation.warehouseId (cross-warehouse transfer is allowed).
//
// Each line produces TWO StockMovement rows:
//   TRANSFER_OUT: fromLocation=source,      toLocation=null,        qty=qty
//   TRANSFER_IN:  fromLocation=null,         toLocation=destination, qty=qty

model InternalTransfer {
  id                    String         @id @default(cuid())
  reference             String         @unique // e.g. WH/INT/0001
  sourceLocationId      String
  sourceLocation        Location       @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId String
  destinationLocation   Location       @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])
  scheduleDate          DateTime
  responsibleId         String
  responsible           User           @relation(fields: [responsibleId], references: [id])
  status                TransferStatus @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lines     InternalTransferLine[]
  movements StockMovement[]        @relation("MovementTransfer")

  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([status])
  @@index([scheduleDate])
  @@index([reference])
}

model InternalTransferLine {
  id                 String           @id @default(cuid())
  internalTransferId String
  internalTransfer   InternalTransfer @relation(fields: [internalTransferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  quantity           Decimal          @db.Decimal(12, 3)

  @@index([internalTransferId])
  @@index([productId])
}

// ─── Stock Adjustment (WH/ADJ/xxxx) ──────────────────────────────────────────
// locationId determines the warehouse.

model StockAdjustment {
  id               String           @id @default(cuid())
  reference        String           @unique // e.g. WH/ADJ/0001
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  systemQuantity   Decimal          @db.Decimal(12, 3) // snapshot at time of adjustment
  physicalQuantity Decimal          @db.Decimal(12, 3) // counted by staff
  difference       Decimal          @db.Decimal(12, 3) // physicalQuantity - systemQuantity
  reason           AdjustmentReason
  reasonNote       String?          // free text when reason = OTHER
  responsibleId    String
  responsible      User             @relation(fields: [responsibleId], references: [id])
  status           AdjustmentStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  movements StockMovement[] @relation("MovementAdjustment")

  @@index([locationId])
  @@index([productId])
  @@index([status])
  @@index([reference])
}

// ─── Stock Movement Ledger (insert-only, never updated or deleted) ────────────
//
// sourceType  — discriminator; exactly one of the four FK fields must be set.
//               Service layer enforces this invariant on every insert.
//
// fromLocation / toLocation semantics per movementType:
//   RECEIPT     : from=null,   to=receipt destination location
//   DELIVERY    : from=delivery source location,  to=null
//   TRANSFER_OUT: from=source, to=null
//   TRANSFER_IN : from=null,   to=destination
//   ADJUSTMENT  : negative diff uses from=location, to=null;
//                 positive diff uses from=null, to=location.
//                 Quantity is the absolute value of the difference.

model StockMovement {
  id             String         @id @default(cuid())
  movementType   MovementType
  sourceType     MovementSource // discriminator — matches exactly one FK below
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  fromLocationId String?
  fromLocation   Location?      @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?      @relation("MovementToLocation", fields: [toLocationId], references: [id])
  quantity       Decimal        @db.Decimal(12, 3)

  // Exactly one of these four must be non-null (enforced by service layer)
  receiptId      String?
  receipt        Receipt?          @relation("MovementReceipt", fields: [receiptId], references: [id])
  deliveryOrderId String?
  deliveryOrder  DeliveryOrder?    @relation("MovementDelivery", fields: [deliveryOrderId], references: [id])
  transferId     String?
  transfer       InternalTransfer? @relation("MovementTransfer", fields: [transferId], references: [id])
  adjustmentId   String?
  adjustment     StockAdjustment?  @relation("MovementAdjustment", fields: [adjustmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sourceType])
  @@index([movementType])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdAt])
  @@index([receiptId])
  @@index([deliveryOrderId])
  @@index([transferId])
  @@index([adjustmentId])
}
