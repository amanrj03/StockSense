// Lemon — Inventory Management System
// Prisma 7 schema for PostgreSQL (Neon)
// FDS v1.1 — https://github.com/your-org/lemon

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// datasource url is managed via prisma7.config.ts / DATABASE_URL env var
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ReceiptStatus {
  DRAFT
  READY
  DONE
  CANCELED
}

enum DeliveryOrderStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum TransferStatus {
  DRAFT
  READY
  DONE
  CANCELED
}

enum AdjustmentStatus {
  DRAFT
  DONE
}

enum AdjustmentReason {
  DAMAGED
  LOST
  MISCOUNT
  OTHER
}

enum MovementType {
  RECEIPT
  DELIVERY
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique // 6–12 chars, unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Operations this user is responsible for
  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  internalTransfers InternalTransfer[]
  adjustments       StockAdjustment[]

  @@index([loginId])
  @@index([email])
}

// ─── Warehouse & Location ─────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique // e.g. "WH"
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations         Location[]
  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  internalTransfers InternalTransfer[]
  adjustments       StockAdjustment[]
  stockEntries      Stock[]

  @@index([shortCode])
}

model Location {
  id          String    @id @default(cuid())
  name        String
  shortCode   String // e.g. "STOCK1", "RACK-A"
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stockEntries           Stock[]
  receiptsTo             Receipt[]           @relation("ReceiptToLocation")
  deliveryOrdersFrom     DeliveryOrder[]     @relation("DeliveryFromLocation")
  transfersSource        InternalTransfer[]  @relation("TransferSourceLocation")
  transfersDestination   InternalTransfer[]  @relation("TransferDestinationLocation")
  adjustments            StockAdjustment[]
  movementsFrom          StockMovement[]     @relation("MovementFromLocation")
  movementsTo            StockMovement[]     @relation("MovementToLocation")

  @@unique([shortCode, warehouseId])
  @@index([warehouseId])
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  sku              String    @unique
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  unitOfMeasure    String    @default("pcs") // e.g. pcs, kg, ltr
  perUnitCost      Decimal   @default(0) @db.Decimal(12, 2)
  reorderLevel     Int?      // low-stock alert threshold
  reorderQty       Int?      // suggested reorder quantity
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  stockEntries      Stock[]
  receiptLines      ReceiptLine[]
  deliveryLines     DeliveryOrderLine[]
  transferLines     InternalTransferLine[]
  adjustments       StockAdjustment[]
  movements         StockMovement[]

  @@index([sku])
  @@index([categoryId])
}

// ─── Stock (on-hand per product per location) ─────────────────────────────────

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  onHand      Decimal   @default(0) @db.Decimal(12, 3)
  reserved    Decimal   @default(0) @db.Decimal(12, 3) // reserved by open Delivery Orders
  updatedAt   DateTime  @updatedAt

  // freeToUse = onHand - reserved (computed in application layer)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@index([warehouseId])
}

// ─── Receipt (incoming stock) ─────────────────────────────────────────────────

model Receipt {
  id          String        @id @default(cuid())
  reference   String        @unique // e.g. WH/IN/0001
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  toLocationId String
  toLocation  Location      @relation("ReceiptToLocation", fields: [toLocationId], references: [id])
  contact     String        // vendor / supplier name
  scheduleDate DateTime
  responsibleId String
  responsible  User         @relation(fields: [responsibleId], references: [id])
  status      ReceiptStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines     ReceiptLine[]
  movements StockMovement[]

  @@index([warehouseId])
  @@index([status])
  @@index([scheduleDate])
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)

  @@index([receiptId])
  @@index([productId])
}

// ─── Delivery Order (outgoing stock) ─────────────────────────────────────────

model DeliveryOrder {
  id              String              @id @default(cuid())
  reference       String              @unique // e.g. WH/OUT/0001
  warehouseId     String
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  fromLocationId  String
  fromLocation    Location            @relation("DeliveryFromLocation", fields: [fromLocationId], references: [id])
  contact         String              // customer name
  deliveryAddress String?
  operationType   String?             // dropdown sub-type
  scheduleDate    DateTime
  responsibleId   String
  responsible     User                @relation(fields: [responsibleId], references: [id])
  status          DeliveryOrderStatus @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lines     DeliveryOrderLine[]
  movements StockMovement[]

  @@index([warehouseId])
  @@index([status])
  @@index([scheduleDate])
}

model DeliveryOrderLine {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)

  @@index([deliveryOrderId])
  @@index([productId])
}

// ─── Internal Transfer ────────────────────────────────────────────────────────

model InternalTransfer {
  id                    String         @id @default(cuid())
  reference             String         @unique // e.g. WH/INT/0001
  warehouseId           String
  warehouse             Warehouse      @relation(fields: [warehouseId], references: [id])
  sourceLocationId      String
  sourceLocation        Location       @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId String
  destinationLocation   Location       @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id])
  scheduleDate          DateTime
  responsibleId         String
  responsible           User           @relation(fields: [responsibleId], references: [id])
  status                TransferStatus @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lines     InternalTransferLine[]
  movements StockMovement[]

  @@index([warehouseId])
  @@index([status])
  @@index([scheduleDate])
}

model InternalTransferLine {
  id                 String           @id @default(cuid())
  internalTransferId String
  internalTransfer   InternalTransfer @relation(fields: [internalTransferId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  quantity           Decimal          @db.Decimal(12, 3)

  @@index([internalTransferId])
  @@index([productId])
}

// ─── Stock Adjustment ─────────────────────────────────────────────────────────

model StockAdjustment {
  id               String           @id @default(cuid())
  reference        String           @unique // e.g. WH/ADJ/0001
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  systemQuantity   Decimal          @db.Decimal(12, 3) // snapshot at time of adjustment
  physicalQuantity Decimal          @db.Decimal(12, 3) // counted by staff
  difference       Decimal          @db.Decimal(12, 3) // physicalQuantity - systemQuantity
  reason           AdjustmentReason
  reasonNote       String?          // free text for "OTHER"
  responsibleId    String
  responsible      User             @relation(fields: [responsibleId], references: [id])
  status           AdjustmentStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  movements StockMovement[]

  @@index([warehouseId])
  @@index([productId])
  @@index([status])
}

// ─── Stock Movement Ledger ────────────────────────────────────────────────────

model StockMovement {
  id               String       @id @default(cuid())
  movementType     MovementType
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  fromLocationId   String?
  fromLocation     Location?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId     String?
  toLocation       Location?    @relation("MovementToLocation", fields: [toLocationId], references: [id])
  quantity         Decimal      @db.Decimal(12, 3)
  // Source document links (only one will be set per movement)
  receiptId        String?
  receipt          Receipt?          @relation(fields: [receiptId], references: [id])
  deliveryOrderId  String?
  deliveryOrder    DeliveryOrder?    @relation(fields: [deliveryOrderId], references: [id])
  transferId       String?
  internalTransfer InternalTransfer? @relation(fields: [transferId], references: [id])
  adjustmentId     String?
  adjustment       StockAdjustment?  @relation(fields: [adjustmentId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([movementType])
  @@index([createdAt])
  @@index([receiptId])
  @@index([deliveryOrderId])
  @@index([transferId])
  @@index([adjustmentId])
}
